{
  "name": "djshellshoxxx/librenms-utility-suite",
  "description": "Modular operational utilities for LibreNMS",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.10",
    "librenms/plugin-interfaces": "^1.0",
    "endroid/qr-code": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.3"
  },
  "autoload": {
    "psr-4": {"Djshellshoxxx\\LibreNMSUtilitySuite\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"Djshellshoxxx\\LibreNMSUtilitySuite\\Tests\\": "tests/"}
  },
  "extra": {
    "laravel": {
      "providers": ["Djshellshoxxx\\LibreNMSUtilitySuite\\UtilitySuiteServiceProvider"]
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:phpunit": "phpunit",
    "test:syntax": "find src tests database routes -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
